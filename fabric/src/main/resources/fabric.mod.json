{
  "schemaVersion": 1,
  "id": "saintsdragons",
  "version": "${version}",
  "name": "Saint's Dragons",
  "description": "Adds animated dragons or wyverns or whatever the heck you wanna call them flying reptiles to Minecraft.",
  "license": "MIT",
  "icon": "assets/saintsdragons/saintsdragons.png",
  "entrypoints": {
    "main": [
      "com.leon.saintsdragons.fabric.SaintsDragonsFabric"
    ],
    "client": [
      "com.leon.saintsdragons.fabric.SaintsDragonsFabricClient"
    ],
    "emi": [
      "com.leon.saintsdragons.fabric.compat.emi.SaintsDragonsEmiPlugin"
    ],
    "modmenu": [
      "com.leon.saintsdragons.fabric.SaintsDragonsModMenuIntegration"
    ]
  },
  "mixins": [
    "saintsdragons.mixins.json",
    "saintsdragons-hooks.mixins.json"
  ],
  "accessWidener": "saintsdragons.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "~${minecraft_version}",
    "geckolib": ">=4.8.1"
  },
  "suggests": {
    "cloth-config": ">=${cloth_config_version}",
    "emi": "*"
  }
}
