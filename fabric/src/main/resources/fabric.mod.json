{
  "schemaVersion": 1,
  "id": "saintsdragons",
  "version": "${version}",
  "name": "Saint's Dragons",
  "description": "i can write whatever i want. what are you gonna do? throw shoes at me?",
  "license": "MIT",
  "icon": "assets/saintsdragons/saintsdragons.png",
  "contact": {
    "homepage": "https://raevyx.miraheze.org/wiki/Main_Page"
  },
  "entrypoints": {
    "main": [
      "com.leon.saintsdragons.fabric.SaintsDragonsFabric"
    ],
    "client": [
      "com.leon.saintsdragons.fabric.SaintsDragonsFabricClient"
    ],
    "emi": [
      "com.leon.saintsdragons.client.compat.emi.SaintsDragonsEmiPlugin"
    ],
    "jei_mod_plugin": [
      "com.leon.saintsdragons.client.compat.jei.SaintsDragonsJeiPlugin"
    ],
    "jade": [
      "com.leon.saintsdragons.fabric.integration.jade.JadeDragonPlugin"
    ],
    "modmenu": [
      "com.leon.saintsdragons.fabric.SaintsDragonsModMenuIntegration"
    ]
  },
  "mixins": [
    "saintsdragons.mixins.json",
    "saintsdragons-hooks.mixins.json"
  ],
  "accessWidener": "saintsdragons.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "geckolib": ">=4.8.1"
  },
  "suggests": {
    "cloth-config": ">=${cloth_config_version}",
    "emi": "*",
    "jei": "*"
  }
}
