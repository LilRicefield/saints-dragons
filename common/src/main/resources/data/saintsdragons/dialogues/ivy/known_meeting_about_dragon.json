    "dragon_wrong_1": {
      "speaker": {
        "translate": "entity.saintsdragons.ivy_oleander"
      },
      "text": {
        "text": "Most people talk about dragons like they're all the same. Big wings, sharp teeth, bad temper. Blah, blah, blah."
