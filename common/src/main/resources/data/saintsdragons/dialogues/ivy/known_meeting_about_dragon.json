    "dragon_wrong_2": {
      "speaker": {
        "translate": "entity.saintsdragons.ivy_oleander"
      },
      "text": {
      "text": "That's like saying every person with a sword is a knight."
      },
      "choices": [
        {
          "text": {
            "text": "..."
          },
          "next": "dragon_wrong_3"
        }
      ]
    },
    "dragon_wrong_3": {
      "speaker": {
        "translate": "entity.saintsdragons.ivy_oleander"
      },
      "text": {
        "text": "Or like, if a cat suddenly makes barking-like sounds, it's a dog. Does that make sense? No? *Ahem*, anyway."
