    "texts": [
      {
        "text": "Where was I? Ah, right."
      },
      {
        "text": "Back to what I was saying..."
      },
      {
        "text": "Now, where did I leave off...? Oh, yes."
      },
      {
        "text": "Right, we were talking about this..."
      }
    ],
    "requires_all_flags": [
